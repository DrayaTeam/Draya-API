{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DrayaLiveDb": ""
  },
  "JwtSettings": {
    "Issuer": "http://draya-api.runasp.net/",
    "Audience": "DrayaClients",
    "SecretKey": "YOUR_PRODUCTION_JWT_SECRET_KEY_CONFIGURED_IN_ENV_OR_KEYVAULT",
    "ExpiryMinutes": 60
  },
  "AccountSecurity": {
    "LockoutThreshold": 5,
    "LockoutCooldownMinutes": 15,
    "PasswordResetTokenExpiryMinutes": 60
  }
}